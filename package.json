{
  "name": "hb-p1-tools",
  "description": "Homebridge P1 Tools",
  "author": "Erik Baauw",
  "maintainers": [
    "ebaauw"
  ],
  "license": "Apache-2.0",
  "version": "1.0.2",
  "keywords": [
    "dsmr",
    "p1",
    "dsmrp1",
    "smartmeter",
    "smart-meter",
    "slimmemeter",
    "slimme-meter"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "files": [
    "dist",
    "cli"
  ],
  "bin": {
    "p1": "cli/p1.js"
  },
  "engines": {
    "node": "^24||^22"
  },
  "dependencies": {
    "hb-lib-tools": "~4.0.0-3",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chalk": "^2.2.4",
    "@types/node": "^22.20.2",
    "@types/semver": "^7.8.0",
    "eslint-config-love": "^156.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "doc": "rm -rf doc && typedoc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "prepare": "npm run lint && npm run build && npm run doc && npm run test",
    "test": ": mocha"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebaauw/hb-p1-tools.git"
  },
  "bugs": {
    "url": "https://github.com/ebaauw/hb-p1-tools/issues"
  },
  "homepage": "https://github.com/ebaauw/hb-p1-tools#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ebaauw"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.me/ebaauw/EUR"
    }
  ]
}
