{
  "name": "hb-p1-tools",
  "description": "Homebridge P1 Tools",
  "license": "Apache-2.0",
  "version": "1.0.1",
  "keywords": [
    "dsmr",
    "p1",
    "dsmrp1",
    "smartmeter",
    "smart-meter",
    "slimmemeter",
    "slimme-meter"
  ],
  "type": "module",
  "exports": {
    "./*": "./lib/*.js"
  },
  "files": [
    "index.js",
    "lib",
    "cli"
  ],
  "bin": {
    "p1": "cli/p1.js"
  },
  "engines": {
    "node": "^24||^22"
  },
  "dependencies": {
    "hb-lib-tools": "~3.0.11",
    "serialport": "^13.0.0"
  },
  "scripts": {
    "prepare": "standard && rm -rf out && jsdoc -c jsdoc.json",
    "test": "standard && echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebaauw/hb-p1-tools.git"
  },
  "bugs": {
    "url": "https://github.com/ebaauw/hb-p1-tools/issues"
  },
  "homepage": "https://github.com/ebaauw/hb-p1-tools#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ebaauw"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.me/ebaauw/EUR"
    }
  ],
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true
  }
}
